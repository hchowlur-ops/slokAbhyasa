/library/
/quizzes/
/local.json
# a save in progress, and a file the app could not read, kept beside its place (datafile.js)
*.tmp-*
*.broken-*

# Built packages (tools/package.mjs) and the Node runtime it downloads
/dist/

# Demo video production: generated sound, narration and captured frames
/tools/demo/audio/
/tools/demo/narration/
/tools/demo/out/

# Node (the app has no dependencies; npm test still writes an empty lockfile)
node_modules/
/package-lock.json
npm-debug.log*

# Operating system clutter
.DS_Store
Thumbs.db
desktop.ini

# research and design notes: their own private repository (hchowlur-ops/SlokaAbhyasa-research-notes)
research_notes/
# the agents' operating instructions live there too (research_notes/sdlc/CLAUDE.md); this root file only imports them
/CLAUDE.md
/CLAUDE.local.md
tools/bench/package-lock.json
