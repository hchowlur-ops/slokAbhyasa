    { "chapter": 12, "verses": 1, "name": { "deva": "भक्तियोग", "iast": "bhaktiyoga", "en": "The Yoga of Devotion" } }
  ],
  "verses": [
    { "id": "1.21", "kind": "verse", "chapter": 1, "verse": 21, "verseEnd": null,
      "speaker": { "who": "arjuna", "deva": "अर्जुन उवाच", "iast": "arjuna uvāca" },
      "deva": ["हृषीकेशं तदा वाक्यमिदमाह महीपते ।", "सेनयोरुभयोर्मध्ये रथं स्थापय मेऽच्युत ॥"],
      "iast": ["hṛṣīkeśaṃ tadā vākyamidamāha mahīpate |", "senayorubhayormadhye rathaṃ sthāpaya me’acyuta ||"],
      "metre": { "family": "anushtubh", "name": "anuṣṭubh" },
      "translations": { "en": "Arjuna said: In the midst between the two armies, O Achyuta, stay my car." },
      "variants": [], "recitedWith": "1.21-22" },
    { "id": "1.22", "kind": "verse", "chapter": 1, "verse": 22, "verseEnd": null,
      "speaker": { "who": "arjuna", "deva": null, "iast": null },
      "deva": ["यावदेतान्निरीक्षेऽहं योद्धुकामानवस्थितान् ।", "कैर्मया सह योद्धव्यमस्मिन् रणसमुद्यमे ॥"],
      "iast": ["yāvadetānnirīkṣe’ahaṃ yoddhukāmānavasthitān |", "kairmayā saha yoddhavyamasmin raṇasamudyame ||"],
      "metre": { "family": "anushtubh", "name": "anuṣṭubh" },
      "translations": { "en": "That I may behold these standing, longing for battle, with whom I must strive in this outbreaking war." },
      "variants": [], "recitedWith": "1.21-22" },
    { "id": "1.21-22", "kind": "combined", "chapter": 1, "verse": 21, "verseEnd": 22,
      "speaker": { "who": "arjuna", "deva": "अर्जुन उवाच", "iast": "arjuna uvāca" },
      "deva": ["हृषीकेशं तदा वाक्यमिदमाह महीपते ।", "सेनयोरुभयोर्मध्ये रथं स्थापय मेऽच्युत ॥", "यावदेतान्निरीक्षेऽहं योद्धुकामानवस्थितान् ।", "कैर्मया सह योद्धव्यमस्मिन् रणसमुद्यमे ॥"],
      "iast": ["hṛṣīkeśaṃ tadā vākyamidamāha mahīpate |", "senayorubhayormadhye rathaṃ sthāpaya me’acyuta ||", "yāvadetānnirīkṣe’ahaṃ yoddhukāmānavasthitān |", "kairmayā saha yoddhavyamasmin raṇasamudyame ||"],
      "metre": { "family": "anushtubh", "name": "anuṣṭubh" },
      "translations": { "en": "Arjuna said: In the midst between the two armies, O Achyuta, stay my car, that I may behold these standing, longing for battle." },
      "variants": [], "recitedWith": null },
    { "id": "2.5", "kind": "verse", "chapter": 2, "verse": 5, "verseEnd": null,
      "speaker": { "who": "arjuna", "deva": null, "iast": null },
      "deva": ["गुरूनहत्वा हि महानुभावान्", "श्रेयो भोक्तुं भैक्ष्यमपीह लोके ।", "हत्वार्थकामांस्तु गुरूनिहैव", "भुञ्जीय भोगान् रुधिरप्रदिग्धान् ॥"],
      "iast": ["gurūnahatvā hi mahānubhāvān", "śreyo bhoktuṃ bhaikṣyamapīha loke |", "hatvārthakāmāṃstu gurūnihaiva", "bhuñjīya bhogān rudhirapradigdhān ||"],
      "metre": { "family": "trishtubh", "name": "triṣṭubh" },
      "translations": { "en": "Better in this world to eat even the beggars' crust, than to slay these most noble Gurus." },
      "variants": [], "recitedWith": null },
    { "id": "12.3", "kind": "verse", "chapter": 12, "verse": 3, "verseEnd": null,
      "speaker": { "who": "krishna", "deva": null, "iast": null },
      "deva": ["ये त्वक्षरमनिर्देश्यमव्यक्तं पर्युपासते ।", "सर्वत्रगमचिन्त्यं च कूटस्थमचलं ध्रुवम् ॥"],
      "iast": ["ye tvakṣaramanirdeśyamavyaktaṃ paryupāsate |", "sarvatragamacintyaṃ ca kūṭasthamacalaṃ dhruvam ||"],
      "metre": { "family": "anushtubh", "name": "anuṣṭubh" },
      "translations": { "en": "They who worship the Indestructible, the Ineffable, the Unmanifested, Omnipresent, Unthinkable, Unchanging, Immutable, Eternal," },
      "variants": [{ "line": 1, "text": "ये त्वक्षरमनिर्देश्यम्", "replaces": "ये त्वक्षरम् अनिर्देश्यम्", "note": "sandhi written out" }], "recitedWith": null },
    { "id": "12.colophon", "kind": "colophon", "chapter": 12, "verse": null, "verseEnd": null,
      "speaker": null,
      "deva": ["ॐ तत्सदिति श्रीमद्भगवद्गीतासूपनिषत्सु ब्रह्मविद्यायां योगशास्त्रे श्रीकृष्णार्जुनसंवादे भक्तियोगो नाम द्वादशोऽध्यायः ॥"],
      "iast": ["oṃ tatsaditi śrīmadbhagavadgītāsūpaniṣatsu brahmavidyāyāṃ yogaśāstre śrīkṛṣṇārjunasaṃvāde bhaktiyogo nāma dvādaśo’adhyāyaḥ ||"],
      "metre": null, "translations": {}, "variants": [], "recitedWith": null }
  ]
